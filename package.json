{
  "name": "ohaninio-manager",
  "version": "0.1.0",
  "description": "Claude Code session orchestrator with web dashboard, full-page agent view, and CLI tools",
  "type": "module",
  "bin": {
    "ohaninio-manager": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "dev:web": "cd web && bunx --bun vite --port 5174",
    "build": "bun run scripts/build.ts",
    "start": "bun run src/server.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
